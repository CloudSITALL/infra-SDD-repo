{
  "name": "Infra SDD Platform",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9.8",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install --break-system-packages checkov pre-commit && npm install -g @google/gemini-cli && curl -LsSf https://astral.sh/uv/install.sh | sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "GitHub.copilot",
        "Google.geminicodeassist"
      ]
    }
  }
}
